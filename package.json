{
  "name": "studia-platform",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm:server\" \"npm:client\"",
    "server": "node --watch server/index.js",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "images": "node scripts/optimize-images.mjs",
    "handoff:zip": "python scripts/package_handoff.py",
    "client": "vite --configLoader runner",
    "build": "vite build --configLoader runner",
    "start": "node server/index.js",
    "test:api": "node --test tests/api.test.js tests/groups.test.js tests/direct-chats.test.js tests/ai-groups.test.js tests/ai-all-sections.test.js tests/ai-proposal.test.js tests/ai-images.test.js tests/security.test.js tests/pagination.test.js tests/migrations.test.js tests/persistence.test.js",
    "test:ui": "vitest run --configLoader runner",
    "test:unit": "node --test tests/course-links.test.js tests/gpa.test.js tests/journal.test.js tests/schedule-import.test.js tests/reminder-notifications.test.mjs tests/server-host.test.js",
    "codespace:start": "bash scripts/start-codespace.sh",
    "codespace:stop": "bash scripts/stop-codespace.sh",
    "test:all": "npm run test:api && npm run test:unit && npm run test:ui",
    "format": "prettier --write \"src/**/*.{js,jsx,css,mjs}\" \"server/**/*.{js,mjs}\" \"scripts/**/*.{js,mjs}\" \"tests/**/*.{js,jsx,mjs}\" \"vite.config.js\" \"package.json\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css,mjs}\" \"server/**/*.{js,mjs}\" \"scripts/**/*.{js,mjs}\" \"tests/**/*.{js,jsx,mjs}\" \"vite.config.js\" \"package.json\""
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "vite": "^6.0.5",
    "vitest": "^5.0.5"
  }
}
