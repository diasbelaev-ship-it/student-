PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# Только если приложение находится за прокси. false — прямое подключение; либо число доверенных переходов.
TRUST_PROXY=false
BACKUP_ENABLED=false
BACKUP_KEEP=14
STUDIA_BACKUP_PATH=backups
REQUIRE_EMAIL_VERIFICATION=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Секрет используется только сервером. Не добавляйте его во фронтенд и репозиторий.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
